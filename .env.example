# Copy to .env in the project root (gitignored). Either provider works; Azure wins if both.

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<key>
# deployment name; DEPLOYMENT or MODEL_NAME also accepted
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# API_VERSION also accepted
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ---- or Anthropic ----
# ANTHROPIC_API_KEY=<key>
